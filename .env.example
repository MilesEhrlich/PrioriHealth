# Copy to .env and fill in. Never commit .env.

# watsonx.ai (usage is capped by llm.monthly_token_budget.watsonx in config.yaml)
WATSONX_APIKEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=

# Anthropic (fallback provider, optional)
ANTHROPIC_API_KEY=

# Ollama (local development on a Mac/PC)
OLLAMA_HOST=http://localhost:11434

# llama.cpp llama-server (IBM LinuxONE deployment)
LLAMACPP_HOST=http://127.0.0.1:8080

# Default engine override for a deployment: watsonx | ollama | llamacpp
# PRIORIHEALTH_PROVIDER=llamacpp
