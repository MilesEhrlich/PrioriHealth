[Unit]
Description=PrioriHealth Granite model server (llama.cpp on IBM LinuxONE)
After=network.target

[Service]
User=@USER@
ExecStart=@OPT@/llama.cpp/build/bin/llama-server \
  -m @OPT@/models/granite-3.3-2b-instruct-be.Q8_0.gguf \
  --alias granite-3.3-2b-instruct-be-q8_0 \
  --host 127.0.0.1 --port 8080 \
  -c 8192 --parallel 2 -t @THREADS@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
