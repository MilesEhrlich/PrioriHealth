[Unit]
Description=PrioriHealth web app (FastAPI + React) on IBM LinuxONE
After=network.target priorihealth-llama.service

[Service]
User=@USER@
WorkingDirectory=@ROOT@
Environment=PRIORIHEALTH_PROVIDER=llamacpp
Environment=LLAMACPP_HOST=http://127.0.0.1:8080
Environment=PRIORIHEALTH_ACCELERATOR=@ACCEL@
ExecStart=@ROOT@/.venv/bin/python scripts/serve.py --host 0.0.0.0 --port @PORT@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
